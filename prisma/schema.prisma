// Схема данных цифровой визитки.
// PostgreSQL поднимается вместе с приложением через docker-compose.
// Генератор "prisma-client" — новый Rust-free клиент (Prisma ORM 7+):
// не требует скачивания бинарного query-engine, поэтому корректно
// работает и в офлайн-окружениях, и в serverless (Vercel).
// Подключение к БД в Prisma 7 задаётся ВНЕ схемы: для CLI — в prisma.config.ts,
// для рантайма приложения — через Driver Adapter в PrismaService/seed.ts.
// Поле datasource.url больше не поддерживается схемой (см. prisma.config.ts).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Specialist {
  id          String   @id @default(cuid())
  fullName    String
  role        String
  tagline     String
  location    String
  avatarUrl   String?
  email       String
  telegram    String?
  github      String?
  website     String?
  bio         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills      Skill[]
  projects    Project[]
  experience  ExperienceItem[]
}

model Skill {
  id           String     @id @default(cuid())
  name         String
  category     String     // "language" | "framework" | "database" | "devops" | "tooling"
  level        Int        // 1..5
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  specialistId String
}

model Project {
  id           String     @id @default(cuid())
  title        String
  description  String
  stack        String     // список технологий через запятую
  repoUrl      String?
  demoUrl      String?
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  specialistId String
}

model ExperienceItem {
  id           String     @id @default(cuid())
  period       String
  title        String
  description  String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  specialistId String
}

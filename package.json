{
  "name": "digital-business-card",
  "version": "1.0.0",
  "description": "Цифровая визитка специалиста — NestJS + GraphQL + Prisma API, отдающее данные для карточки-портфолио",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "ts-node -O \"{\\\"module\\\": \\\"CommonJS\\\"}\" prisma/seed.ts",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "ts-node -O \"{\\\"module\\\": \\\"CommonJS\\\"}\" prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.2",
    "@nestjs/apollo": "^12.2.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/graphql": "^12.2.1",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@prisma/client": "^6.19.3",
    "graphql": "^16.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/node": "^22.10.2",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "@nestjs/core@10.4.22": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}

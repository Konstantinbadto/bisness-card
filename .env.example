# Скопируйте этот файл в .env и при необходимости отредактируйте.

# Используется приложением в рантайме (через Driver Adapter в PrismaService).
# Для локального запуска через docker-compose (см. docker-compose.yml):
DATABASE_URL="postgresql://card:card@localhost:5432/business_card?schema=public"

# Используется CLI-командами (`prisma generate`/`db push`/`migrate`) —
# см. prisma.config.ts. Нужно ПРЯМОЕ (не через pgbouncer/pooler) соединение.
# Для Neon: тот же connection string, но без "-pooler" в адресе хоста.
# Для локального Docker-Postgres достаточно продублировать DATABASE_URL.
DIRECT_URL="postgresql://card:card@localhost:5432/business_card?schema=public"

PORT=3000
